# Mario Kart 64 -> Sony PSP port build.
#
#   export PATH="$HOME/pspdev/bin:$PATH"
#   gmake -f Makefile.psp -j8            # -> build/psp/EBOOT.PBP
#
# Needs GNU make >= 4 (macOS: brew install make -> gmake), the pspdev toolchain,
# the decomp host tools (tools/mio0, tools/n64graphics, tools/torch) and the
# extracted assets (extract_assets.py us; torch code/header baserom.us.z64).
#
# The game code is the n64decomp/mk64 C source compiled for the PSP.  Everything
# the N64 game DMAs out of the cartridge is linked into the executable instead
# (same .s/.incbin files as the N64 build), and src/port/ replaces libultra, the
# RSP graphics microcode (F3DEX -> sceGu) and the RSP audio microcode (C mixer).

include util.mk

VERSION    := us
BUILD_DIR  := build/psp
TARGET     := mk64
ELF        := $(BUILD_DIR)/$(TARGET).elf
PRX        := $(BUILD_DIR)/$(TARGET).prx
EBOOT      := $(BUILD_DIR)/EBOOT.PBP
BASEROM    := baserom.$(VERSION).z64

PSPSDK     := $(shell psp-config --pspsdk-path)
PSPDEV     := $(shell psp-config --pspdev-path)

VERBOSE ?= 0
ifeq ($(VERBOSE),0)
  V := @
endif

COLOR ?= 1
ifeq ($(COLOR),1)
NO_COL  := \033[0m
RED     := \033[0;31m
GREEN   := \033[0;32m
BLUE    := \033[0;34m
YELLOW  := \033[0;33m
endif
PRINT := printf
TOUCH := touch

#==============================================================================#
# Tools                                                                        #
#==============================================================================#

TOOLS_DIR     := tools
PYTHON        ?= python3
MIO0TOOL      := $(TOOLS_DIR)/mio0
N64GRAPHICS   := $(TOOLS_DIR)/n64graphics
ASSET_EXTRACT := $(PYTHON) $(TOOLS_DIR)/new_extract_assets.py
ASM_BE        := $(PYTHON) $(TOOLS_DIR)/psp/asm_be.py
ASSET_DIR     := assets
DATA_DIR      := data
TEXTURES_DIR  := textures

CC      := psp-gcc
AS      := psp-as
LD      := psp-gcc
OBJDUMP := psp-objdump

#==============================================================================#
# Sources                                                                      #
#==============================================================================#

# Game code (the decomp) - same directories the N64 build uses, minus libultra.
# (rainbow_road_tluts and ceremony_rsp_init_80284EE0 are #included by other files, not compiled.)
SRC_ASSETS_DIR := assets/code/ceremony_data assets/code/startup_logo assets/code/data_800E45C0 \
                  assets/code/data_800E8700 assets/code/common_data
GAME_SRC_DIRS  := src src/data src/buffers src/racing src/ending src/audio courses $(SRC_ASSETS_DIR)
# Port layer (libultra replacement, F3DEX interpreter, audio mixer, PSP backends).
PORT_SRC_DIRS  := src/port src/port/gfx src/port/audio src/port/psp
# Pure-C pieces of libultra that the game relies on for bit-exact behaviour.
OS_C_FILES     := $(wildcard src/os/gu*.c) src/os/math/sinf.c src/os/math/cosf.c

# Course data is compiled straight from its C sources (the N64 build packs and
# mio0-compresses these into the ROM; the port skips that and keeps them as C).
COURSE_DIRS  := $(shell find courses -mindepth 1 -type d | sort)
COURSE_FILES := $(foreach dir,$(COURSE_DIRS),$(dir)/course_data.c $(dir)/course_offsets.c \
                  $(dir)/course_displaylists.inc.c $(dir)/course_vertices.inc.c)

C_FILES := $(filter-out %.inc.c,$(foreach dir,$(GAME_SRC_DIRS) $(PORT_SRC_DIRS),$(wildcard $(dir)/*.c))) \
           $(OS_C_FILES) $(COURSE_FILES)

# Binary data (textures, kart sprites, audio banks/sequences) - the same
# .incbin assembly files the N64 build uses.  rsp.s (microcode) is not needed.
S_FILES := $(filter-out $(DATA_DIR)/rsp.s,$(wildcard $(DATA_DIR)/*.s)) \
           $(wildcard $(DATA_DIR)/karts/*.s) \
           $(DATA_DIR)/sound_data/instrument_sets.s $(DATA_DIR)/sound_data/sequences.s \
           src/port/audio_blobs.s

# Generated: segmented address -> symbol tables (see tools/psp/gen_seg_tables.py).
SEG_TABLES_C := $(BUILD_DIR)/port_seg_tables.c

RECIPES_JSON := tools/psp/recipes.json
RECIPES_BIN  := $(BUILD_DIR)/recipes.bin
DATA_PSAR    := $(BUILD_DIR)/data.psar
O_FILES := $(foreach f,$(C_FILES),$(BUILD_DIR)/$(f:.c=.o)) \
           $(foreach f,$(S_FILES),$(BUILD_DIR)/$(f:.s=.o)) \
           $(SEG_TABLES_C:.c=.o)

DEP_FILES := $(O_FILES:.o=.d)

ALL_DIRS := $(BUILD_DIR) $(addprefix $(BUILD_DIR)/,$(GAME_SRC_DIRS) $(PORT_SRC_DIRS) src/os src/os/math $(COURSE_DIRS) \
            $(DATA_DIR) $(DATA_DIR)/karts $(DATA_DIR)/sound_data \
            $(TEXTURES_DIR)/raw $(TEXTURES_DIR)/standalone $(TEXTURES_DIR)/startup_logo \
            $(TEXTURES_DIR)/crash_screen $(TEXTURES_DIR)/trophy $(TEXTURES_DIR)/courses $(TEXTURES_DIR)/common)

# Make sure build directory exists before compiling anything
DUMMY != mkdir -p $(ALL_DIRS)

#==============================================================================#
# Flags                                                                        #
#==============================================================================#

DEFINES := PORT_GE_TL=1 PORT_DRAW_DIST=3000 PORT_MAX_VOICES=18 VERSION_US=1 F3DEX_GBI=1 F3D_OLD=1 NON_MATCHING=1 AVOID_UB=1 TARGET_PSP=1 _LANGUAGE_C=1 NO_SEGMENTED_MEMORY=1 \
           PSP_LEGACY_TYPES_DEFINED=1 PSP_LEGACY_VOLATILE_TYPES_DEFINED=1
C_DEFINES := $(foreach d,$(DEFINES),-D$(d))

INCLUDE_DIRS := include $(BUILD_DIR) $(BUILD_DIR)/include src src/racing src/ending src/port src/port/gfx src/port/audio src/port/psp .
DEF_INC_CFLAGS := $(foreach i,$(INCLUDE_DIRS),-I$(i)) $(C_DEFINES) -I$(PSPSDK)/include

OPT_FLAGS ?= -O2 $(EXTRA_CFLAGS)
CFLAGS  := $(OPT_FLAGS) -G0 -std=gnu99 -fsigned-char -fno-strict-aliasing -fwrapv -fno-common \
           -Wall -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function -Wno-unused-parameter \
           -Wno-missing-braces -Wno-char-subscripts -Wno-sign-compare -Wno-int-in-bool-context \
           -Wno-error=incompatible-pointer-types -Wno-error=int-conversion \
           $(DEF_INC_CFLAGS)
ASFLAGS := -I include -I $(BUILD_DIR) -I .

LDFLAGS := -specs=$(PSPSDK)/lib/prxspecs -Wl,-q,-T$(PSPSDK)/lib/linkfile.prx -Wl,-zmax-page-size=128 \
           $(PSPSDK)/lib/prxexports.o -L$(PSPSDK)/lib -L$(PSPDEV)/psp/lib
# N64 ROM-segment symbols that alias data linked in from the .s files.
LDFLAGS += -Wl,--defsym=_sequencesSegmentRomStart=music_sequence_table_header \
           -Wl,--defsym=_instrument_setsSegmentRomStart=instrument_sets \
           -Wl,--defsym=_audio_banksSegmentRomStart=port_audiobanks \
           -Wl,--defsym=_audio_tablesSegmentRomStart=port_audiotables \
           -Wl,--defsym=D_0B002A00=texture_player_select+0x2A00
LDFLAGS += -Wl,--defsym=_trigTablesSegmentStart=gSineTable -Wl,--defsym=_trigTablesSegmentRomStart=gSineTable

# torch emits the gold reflection map in both the startup logo and ceremony segments.
$(BUILD_DIR)/assets/code/startup_logo/startup_logo.o: CFLAGS += -Dreflection_map_gold=reflection_map_gold_logo
# Only the extra libraries: psp-gcc's default spec appends -lc/-lpspuser/... last.
# Listing those again scans the stub archives twice, which splits each SDK
# library's import stubs into two runs and psp-fixup-imports then bails out.
LIBS    := -lpspgu -lpspgum -lpspvfpu -lpspmath -lpspctrl -lpspge -lpspdisplay -lpspaudio -lpsppower -lpspdebug

#==============================================================================#
# Main targets                                                                 #
#==============================================================================#

ASSET_OBJS := $(filter $(BUILD_DIR)/assets/% $(BUILD_DIR)/courses/% $(BUILD_DIR)/data/% \
                       $(BUILD_DIR)/src/port/audio_blobs.o $(BUILD_DIR)/src/data/textures.o \
                       $(BUILD_DIR)/src/data/some_data.o $(BUILD_DIR)/src/data/data_segment2.o \
                       $(BUILD_DIR)/src/data/path_spawn_metadata.o,$(O_FILES))
ELF_ASSETS   := $(BUILD_DIR)/mk64_assets.elf
ASSETS_BIN   := $(BUILD_DIR)/assets.bin
LINK_NOLOAD  := $(BUILD_DIR)/linkfile_noload.prx
LINK_PROGBITS:= $(BUILD_DIR)/linkfile_progbits.prx
comma := ,
LDFLAGS_BASE := $(filter-out -Wl$(comma)-q$(comma)-T$(PSPSDK)/lib/linkfile.prx,$(LDFLAGS))
ASSET_SECTION_NOLOAD   = .assetdata (NOLOAD) : ALIGN(16) { __assets_start = .; *(.assetdata) *(.assetrodata) . = ALIGN(16); __assets_end = .; }
ASSET_SECTION_PROGBITS = .assetdata : ALIGN(16) { __assets_start = .; *(.assetdata) *(.assetrodata) . = ALIGN(16); __assets_end = .; }


default: all
all: $(EBOOT) $(ASSETS_BIN)

# Slow (minutes): find, for every asset symbol, how it derives from the ROM.
# Needed only when the set of assets changes.  Keeps its mio0 cache in build/.
assets-recipes: $(ASSETS_BIN)
	python3 tools/psp/derive_recipes.py $(ASSETS_BIN) baserom.us.z64 -o $(RECIPES_JSON) --cache $(BUILD_DIR)/mio0.cache --report $(BUILD_DIR)/recipes_report.txt

# The recipe blob rides in the EBOOT's DATA.PSAR (numbers only); it depends on
# the link (pointer values) but not the other way round.
$(RECIPES_BIN): $(wildcard $(RECIPES_JSON)) $(ASSETS_BIN) tools/psp/emit_recipes.py
	$(V)if [ -f $(RECIPES_JSON) ]; then python3 tools/psp/emit_recipes.py $(RECIPES_JSON) $(ASSETS_BIN) -o $@; \
	else echo "NOTE: $(RECIPES_JSON) missing - EBOOT cannot extract from a ROM (run: gmake -f Makefile.psp assets-recipes)"; printf 'MK64RCP0' > $@; fi

# Compile everything but do not link - handy while porting.
objs: $(O_FILES)

clean:
	$(RM) -r $(BUILD_DIR)

.PHONY: default all assets-recipes objs clean

define print
  @$(PRINT) "$(GREEN)$(1) $(YELLOW)$(2)$(GREEN) -> $(BLUE)$(3)$(NO_COL)\n"
endef

#==============================================================================#
# Texture generation (same recipes as the N64 build)                           #
#==============================================================================#

# RGBA32, RGBA16, IA16, IA8, IA4, IA1, I8, I4 (png -> raw texel data)
$(BUILD_DIR)/%: %.png
	$(call print,Converting:,$<,$@)
	$(V)$(N64GRAPHICS) -i $@ -g $< -f $(lastword $(subst ., ,$@))

$(BUILD_DIR)/textures/%.mio0: $(BUILD_DIR)/textures/%
	$(V)$(MIO0TOOL) -c $< $@

# Per-asset-group rules shipped with the decomp (kart sprites, character select,
# course actor textures, ...).  They only need the variables defined above.
ASSET_INCLUDES := $(shell find $(ASSET_DIR)/include -type f -name "*.mk")
$(foreach inc,$(ASSET_INCLUDES),$(eval include $(inc)))

STANDALONE_TEXTURE_MIO0_FILES := $(addprefix $(BUILD_DIR)/,$(patsubst %.png,%.mio0,$(wildcard $(TEXTURES_DIR)/standalone/*.png)))
RAW_TEXTURE_FILES := $(addprefix $(BUILD_DIR)/,$(patsubst %.png,%,$(wildcard $(TEXTURES_DIR)/raw/*.png)))

# Segment-5 texture addresses for each course's display lists.
COURSE_TEXTURE_HEADERS := $(foreach dir,$(COURSE_DIRS),$(dir)/course_textures.linkonly.h)
%/course_textures.linkonly.h: %/course_offsets.c tools/psp/gen_course_textures.py
	$(V)$(PYTHON) tools/psp/gen_course_textures.py $(lastword $(subst /, ,$*))
$(foreach dir,$(COURSE_DIRS),$(BUILD_DIR)/$(dir)/course_data.o $(BUILD_DIR)/$(dir)/course_displaylists.inc.o): $(COURSE_TEXTURE_HEADERS)

# Torch emits RGBA16 textures and TLUTs as u16 arrays (native-endian on the
# PSP) while the gfx importers read texel data big-endian like the N64.  Shadow
# those .inc.c files with byte-swapped copies in the build dir, which precedes
# the source tree in the include path.
U16_INC_FILES := $(sort $(shell grep -rhA12 -E '^u16 [A-Za-z0-9_]+(\[[0-9]*\])+ = \{' assets/code courses --include=*.c | grep -oE '"[^"]+\.(rgba16|tlut|ia16)\.inc\.c"' | tr -d '"'))
SWAPPED_INC_FILES := $(addprefix $(BUILD_DIR)/,$(U16_INC_FILES))
$(BUILD_DIR)/%.inc.c: %.inc.c tools/psp/swap_u16_inc.py
	@mkdir -p $(dir $@)
	$(V)$(PYTHON) tools/psp/swap_u16_inc.py $< $@

# Hot audio code gets the heavier optimisation level.
$(BUILD_DIR)/src/port/audio/mixer.o $(BUILD_DIR)/src/audio/synthesis.o: CFLAGS += -O3 -funroll-loops

$(BUILD_DIR)/src/crash_screen.o: $(BUILD_DIR)/textures/crash_screen/crash_screen_font.ia1.inc.c
$(BUILD_DIR)/textures/crash_screen/crash_screen_font.ia1.inc.c: textures/crash_screen/crash_screen_font.ia1.png
	$(V)$(N64GRAPHICS) -i $@ -g $< -f ia1 -s u8

#==============================================================================#
# Compilation                                                                  #
#==============================================================================#

# Rebuild everything when the compile flags change (EXTRA_CFLAGS=... on the
# command line must not leave objects built with other flags behind).
CFLAGS_STAMP := $(BUILD_DIR)/cflags.stamp
$(shell mkdir -p $(BUILD_DIR); [ -f $(CFLAGS_STAMP) ] && [ "$$(cat $(CFLAGS_STAMP))" = "$(CFLAGS)" ] || echo "$(CFLAGS)" > $(CFLAGS_STAMP))

$(BUILD_DIR)/%.o: %.c $(SWAPPED_INC_FILES) $(CFLAGS_STAMP)
	$(call print,Compiling:,$<,$@)
	$(V)$(CC) -c $(CFLAGS) -MMD -MP -MF $(BUILD_DIR)/$*.d -o $@ $<

$(SEG_TABLES_C): tools/psp/gen_seg_tables.py $(wildcard courses/*/course_data.h courses/*/course_displaylists.inc.h) $(wildcard yamls/us/*.yml)
	$(call print,Generating:,$@,)
	$(V)$(PYTHON) tools/psp/gen_seg_tables.py $@

$(SEG_TABLES_C:.c=.o): $(SEG_TABLES_C)
	$(call print,Compiling:,$<,$@)
	$(V)$(CC) -c $(CFLAGS) -o $@ $<

# Data .s files: rewrite .word/.hword to big-endian bytes (the game reads these
# tables as raw ROM data), then assemble.
$(BUILD_DIR)/%.s: %.s
	$(V)$(ASM_BE) $< $@

$(BUILD_DIR)/%.o: $(BUILD_DIR)/%.s $(STANDALONE_TEXTURE_MIO0_FILES) $(RAW_TEXTURE_FILES)
	$(call print,Assembling:,$<,$@)
	$(V)$(AS) $(ASFLAGS) -o $@ $<

.PRECIOUS: $(BUILD_DIR)/%.s

#==============================================================================#
# Link + package                                                               #
#==============================================================================#

# ---------------------------------------------------------------------------
# Asset split: the ROM-derived data objects have their .data/.rodata renamed
# to .assetdata/.assetrodata, which the linker collects into one region after
# .bss.  The shipped link makes that region NOLOAD (symbols, no bytes); a second
# identical link with the region as PROGBITS feeds tools/psp/make_assets.py,
# which writes assets.bin (bytes + R_MIPS_32 fix-ups).  psp/assets_load.c reads
# it back at boot.  The EBOOT then contains no Nintendo data.
$(LINK_NOLOAD): $(PSPSDK)/lib/linkfile.prx Makefile.psp
	$(V)sed 's|^  _end = \.;|  $(ASSET_SECTION_NOLOAD)\n  _end = .;|' $< > $@
$(LINK_PROGBITS): $(PSPSDK)/lib/linkfile.prx Makefile.psp
	$(V)sed 's|^  _end = \.;|  $(ASSET_SECTION_PROGBITS)\n  _end = .;|' $< > $@

$(ELF): $(O_FILES) $(LINK_NOLOAD)
	$(call print,Linking:,$@,)
	$(V)for o in $(ASSET_OBJS); do psp-objcopy --preserve-dates --rename-section .data=.assetdata --rename-section .rodata=.assetrodata $$o; done
	$(V)$(LD) $(LDFLAGS_BASE) -Wl,-q,-T$(LINK_NOLOAD) -o $@ $(O_FILES) $(LIBS)
	$(V)psp-fixup-imports $@

$(ELF_ASSETS): $(O_FILES) $(LINK_PROGBITS) $(ELF)
	$(V)$(LD) $(LDFLAGS_BASE) -Wl,-q,-T$(LINK_PROGBITS) -o $@ $(O_FILES) $(LIBS)

$(ASSETS_BIN): $(ELF_ASSETS) $(ELF) tools/psp/make_assets.py
	$(V)python3 tools/psp/make_assets.py $(ELF_ASSETS) $(ELF) -o $@

$(PRX): $(ELF)
	$(V)psp-prxgen $< $@

PSP_EBOOT_TITLE := MK64 Portable
# XMB icon (144x80 PNG) and background (480x272 PNG); fall back to NULL if absent.
PSP_EBOOT_ICON  ?= $(wildcard icon/MK64-ICON0.png)
PSP_EBOOT_PIC1  ?= $(wildcard icon/MK64-PIC1.png)
PSP_EBOOT_ICON  := $(if $(PSP_EBOOT_ICON),$(PSP_EBOOT_ICON),NULL)
PSP_EBOOT_PIC1  := $(if $(PSP_EBOOT_PIC1),$(PSP_EBOOT_PIC1),NULL)

$(BUILD_DIR)/PARAM.SFO:
	$(V)mksfoex "$(PSP_EBOOT_TITLE)" $@

$(DATA_PSAR): $(RECIPES_BIN) tools/psp/make_psar.py $(wildcard icon/MK64-PIC1.png)
	$(V)python3 tools/psp/make_psar.py --recipes $(RECIPES_BIN) $(if $(wildcard icon/MK64-PIC1.png),--pic1 icon/MK64-PIC1.png,) -o $@

$(EBOOT): $(PRX) $(BUILD_DIR)/PARAM.SFO $(DATA_PSAR) $(wildcard icon/MK64-ICON0.png icon/MK64-PIC1.png)
	$(V)pack-pbp $@ $(BUILD_DIR)/PARAM.SFO $(PSP_EBOOT_ICON) NULL NULL $(PSP_EBOOT_PIC1) NULL $(PRX) $(DATA_PSAR)
	@ls -lh $@

# ---------------------------------------------------------------------------
# Release mastering (recipe carried over from the Tetralumen project, where it
# was byte-matched against a homebrew ISO that boots on real ARK-4 hardware):
#   * EBOOT.BIN is the plain UNSIGNED relocatable .prx -- ARK-4 loads it as is.
#   * the image is written by tools/psp/make_iso.py, not mkisofs (no ";1" name
#     suffixes, sane extents for the empty BOOT.BIN/OPNSSMP.BIN placeholders,
#     the disc-id string in the PVD application area).
#   * PARAM.SFO from tools/psp/make_sfo.py (sorted keys + DISC_NUMBER/TOTAL);
#     UMD_DATA.BIN is the exact 48-byte layout.
# The FPS overlay is off by default and toggled by holding SELECT for 3 s, so
# release builds keep it; `gmake -f Makefile.psp release` does a clean rebuild
# into release/, then rebuilds the normal dev EBOOT.
ISO_ROOT    := $(BUILD_DIR)/iso_root
RELEASE_DIR := ../release
DISC_ID     := MKPS00001
DISC_ID_DASH:= MKPS-00001
ISO_VOLID   := MK64PORTABLE

# $(1) = .iso path
define BUILD_ISO
	rm -rf $(ISO_ROOT) $(1)
	mkdir -p $(ISO_ROOT)/PSP_GAME/SYSDIR $(ISO_ROOT)/PSP_GAME/USRDIR $(dir $(1))
	python3 tools/psp/make_sfo.py --title '$(PSP_EBOOT_TITLE)' --disc-id $(DISC_ID) $(ISO_ROOT)/PSP_GAME/PARAM.SFO
	cp $(PRX) $(ISO_ROOT)/PSP_GAME/SYSDIR/EBOOT.BIN
	: > $(ISO_ROOT)/PSP_GAME/SYSDIR/BOOT.BIN
	: > $(ISO_ROOT)/PSP_GAME/SYSDIR/OPNSSMP.BIN
	cp icon/MK64-ICON0.png $(ISO_ROOT)/PSP_GAME/ICON0.PNG
	cp icon/MK64-PIC1.png $(ISO_ROOT)/PSP_GAME/PIC1.PNG
	cp $(ASSETS_BIN) $(ISO_ROOT)/PSP_GAME/USRDIR/assets.bin
	python3 tools/psp/make_umd_data.py $(DISC_ID_DASH) $(ISO_ROOT)/UMD_DATA.BIN
	python3 tools/psp/make_iso.py --volid $(ISO_VOLID) --disc-id $(DISC_ID_DASH) -o $(1) $(ISO_ROOT)
	rm -rf $(ISO_ROOT)
	@ls -lh $(1)
endef

# iso: a test disc of the CURRENT build (whatever flags it has) in ../testing
iso: all $(ASSETS_BIN)
	$(call BUILD_ISO,../testing/mk64.iso)

# release: clean build -> release/EBOOT.PBP (+ README.txt, MD5SUMS.txt),
# then restore the normal dev build in build/ and ../testing.  The EBOOT
# contains no game data: players put their own Mario Kart 64 (USA) .z64 ROM in
# the same folder and the first start builds assets.bin from it.  Nothing else
# (no assets.bin, no ISO) ships.
release:
	$(MAKE) -f Makefile.psp clean
	$(MAKE) -f Makefile.psp all EXTRA_CFLAGS="$(EXTRA_CFLAGS)"
	rm -rf $(RELEASE_DIR)
	mkdir -p $(RELEASE_DIR)
	cp $(EBOOT) $(RELEASE_DIR)/EBOOT.PBP
	printf 'MK64 Portable\n\nAn unofficial fan port for the PSP. It contains no game data: it needs a ROM\nof Mario Kart 64 (USA) that you own. Not affiliated with or endorsed by Nintendo.\n\n1. Copy this folder to ms0:/PSP/GAME/MK64Portable/ (so it holds EBOOT.PBP).\n2. Put your Mario Kart 64 (USA) ROM (.z64, .n64 or .v64) in the same folder.\n3. Start it from the XMB. The first start reads the ROM and builds the game\n   data (about 13 MB) into a data/ folder next to the EBOOT; later starts skip this.\n   Your save is kept there too.\n' > $(RELEASE_DIR)/README.txt
	(cd $(RELEASE_DIR) && (md5 EBOOT.PBP || md5sum EBOOT.PBP) > MD5SUMS.txt)
	$(MAKE) -f Makefile.psp clean
	$(MAKE) -f Makefile.psp all EXTRA_CFLAGS="$(EXTRA_CFLAGS)"
	cp $(EBOOT) ../testing/EBOOT.PBP
	@ls -lh $(RELEASE_DIR)

.PHONY: iso release

-include $(DEP_FILES)

# Remove built-in rules
.SUFFIXES:
